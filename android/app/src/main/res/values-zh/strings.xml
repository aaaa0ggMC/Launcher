    <string name="keepalive_text">保持与宿主的连接和播放</string>
    <string name="shortcut_connect">连接设置</string>
    <string name="err_unreachable">连不上宿主。Termux 里的宿主启动了吗？如果它本来在运行，可能是系统把后台的 Termux 冻结了：切到 Termux 看一眼再回来重试，并把 Termux 锁定在后台、电池设为无限制。</string>
    <string name="err_token">宿主拒绝了这个 token。</string>
    <string name="err_token_api">宿主拒绝了这个 token：连接页里的「Token」填了吗？从宿主上的 ~/.config/LinuxCockpit/headless-token 复制一个。</string>
    <string name="err_http">宿主返回错误：</string>
    <string name="err_disconnected">与宿主的连接断开了</string>
    <!-- 反向代理（Caddy basic_auth / forward_auth）：它和宿主自己的 token 是两套认证，别混 -->
    <string name="err_proxy_auth">反向代理拒绝了这个用户名/密码。请检查后重连。</string>
    <string name="err_proxy_login">代理要求先登录（它会跳到 %1$s）。用浏览器打开这个地址登录一次，再回来重试。</string>
    <string name="err_proxy_retry">试了几次代理登录都没生效。请检查用户名/密码，然后手动重连。</string>
    <string name="err_proxy_cancelled">已取消代理登录。</string>
    <string name="proxy_auth_title">代理需要登录</string>
    <string name="proxy_auth_realm">%1$s · realm %2$s</string>
    <string name="proxy_auth_user">用户名</string>
    <string name="proxy_auth_pass">密码</string>
    <string name="proxy_auth_ok">登录</string>
    <string name="proxy_auth_cancel">取消</string>
    <string name="proxy_auth_cleared">已清除保存的代理凭据</string>
    <string name="reauth_running">代理会话已过期，正在重新登录…</string>
    <!-- 连不上的原因分级（0.9.0）：以前一律 err_unreachable，公网 https 宿主会看到不相干的 Termux 提示 -->
    <string name="err_tls">服务器的 TLS 证书验证失败（不是受信任的 CA 签发的），或者握手被中断。如果是自建 CA：在手机「设置 → 安全 → 加密与凭据 → 安装证书 → CA 证书」里装上那个根 CA——App 和浏览器一样信任用户安装的 CA。</string>
    <string name="err_dns">解析不了宿主的域名。检查地址有没有写错，以及 DNS / 网络是否正常。</string>
    <string name="err_timeout">连接宿主超时。检查地址、端口和网络连通性。</string>
    <string name="err_connect">连不上宿主的端口（被拒绝，或被防火墙挡了）。确认地址、端口，以及宿主服务已经启动。</string>
    <string name="err_remote">连不上宿主。确认地址、端口和服务是否正常，然后重试。</string>
    <string name="err_client_cert">服务器要求客户端证书（mTLS）。如果刚才取消了系统弹出的证书选择，重新连接再选一次；没有可用的客户端证书时，先在手机上安装一个。</string>
    <string name="ssl_bypass_title">证书不受信任</string>
    <string name="ssl_bypass_msg">%1$s 的 TLS 证书有问题：\n%2$s\n\n浏览器能打开、App 打不开，常常是因为 Chrome 自带一套证书校验、和 App 用的不是同一个。仅当你确认这是自己的服务器时再选「仍要连接」。</string>
    <string name="ssl_bypass_ok">仍要连接</string>
    <string name="ssl_bypass_cancel">取消</string>
    <string name="client_cert_picking">服务器要求客户端证书，请在系统弹出的选择框里选一个</string>
