{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/main/ui/**/*",
    "src/main/ui/**/*.vue",
    "src/abilities/**/*",
    "src/background/**/*",
    "src/shared/**/*",
    "src/preload/*.d.ts"
  ],
  "exclude": [
    "src/abilities/*/commands.ts",
    "src/abilities/*/service.ts",
    "src/abilities/*/jobs.ts",
    "src/abilities/*/jobs/**",
    "src/abilities/*/commands/**",
    "src/abilities/campusinfo/sections.ts",
    "src/abilities/campusinfo/sections-extra/**",
    "src/abilities/campusinfo/loginlog.ts",
    "src/abilities/campusinfo/mail/**",
    "src/abilities/campusinfo/hustpass-api.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["src/main/ui/*"],
      "@abilities/*": ["src/abilities/*"],
      "@background/*": ["src/background/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
